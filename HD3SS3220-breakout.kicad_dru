(version 1)
(rule "Allow tight corners on U1"
  (constraint clearance (min 0.07mm))
  (condition "A.Reference == 'U1' && B.Reference == 'U1'"))

(rule "allow_usb_shield_annular"
   (constraint annular_width (min 0mm))
   (condition "A.Reference == 'J1'")
)

# J1's land pattern places the connector's plated shell-peg holes 0.144 mm from
# its own GND shield pads (manufacturer geometry, both part of the grounded
# shell - a drill nick cannot create a fault). Scoped to J1-internal pairs only;
# board-wide hole clearance stays 0.2 mm.
(rule "J1 internal shell-peg hole clearance"
  (constraint hole_clearance (min 0.13mm))
  (condition "A.Reference == 'J1' && B.Reference == 'J1'"))